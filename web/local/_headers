# Cloudflare Pages headers for the browser edition. The page talks to no server
# of its own: connect-src allows only this origin, AI services over HTTPS (when
# the user starts an AI opinion) and a local Ollama.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*.wasm
  Content-Type: application/wasm
